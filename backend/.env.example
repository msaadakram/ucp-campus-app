# Copy to .env (never commit .env):
#   cp .env.example .env
PORT=3001
# Supabase project (Project Settings -> API). SERVICE ROLE key stays HERE,
# on the server only — it bypasses RLS, so never ship it in the app.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...service_role...only...
# Horizon portal base (session verification target).
ODOO_BASE=https://horizon.ucp.edu.pk
# Allowed app origins, comma-separated. Mobile apps send no Origin, so the
# default open policy works for the pilot; tighten for web deployments.
CORS_ORIGIN=*
